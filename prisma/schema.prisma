generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  password      String?
  image         String?
  googleId      String?        @unique
  isTestAccount Boolean        @default(false)

  // Data-processing consent (required at registration)
  analyticsConsentAccepted   Boolean   @default(false)
  analyticsConsentAcceptedAt DateTime?
  analyticsConsentVersion    String?

  // Marketing / demo consent (optional)
  marketingDemoConsentAccepted   Boolean   @default(false)
  marketingDemoConsentAcceptedAt DateTime?
  marketingDemoConsentVersion    String?

  binotelKey    String?
  binotelSecret String?

  calls         Call[]
  salesProfiles SalesProfile[]
  apiKeys       ApiKey[]
  subscription  Subscription?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId               String   @default("free")    // free | starter | growth | pro
  status               String   @default("active")  // active | cancelled | past_due | trialing
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  stripePriceId        String?
  currentPeriodStart   DateTime @default(now())
  currentPeriodEnd     DateTime @default(now())
  minutesUsed          Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String    @default("Default")
  keyHash    String    @unique
  keyPrefix  String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model SalesProfile {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  photo       String?
  calls       Call[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PromoCode {
  id        String    @id @default(cuid())
  code      String    @unique
  planId    String                       // plan granted when code is redeemed
  createdBy String                       // admin email who generated it
  usedBy    String?                      // userId that redeemed it (null = available)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model ApiLog {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String                       // e.g. "binotel", "ringostat", "voiptime"
  status     String                       // "success" | "skipped" | "error" | "auth_failed" | "no_recording"
  statusCode Int
  createdAt  DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Call {
  id              String        @id @default(cuid())
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  salesProfileId  String?
  salesProfile    SalesProfile? @relation(fields: [salesProfileId], references: [id])

  fileName        String
  filePath        String

  source          String   @default("manual")   // "manual" | "binotel" | "ringostat" | "voiptime" | "kyivstar" | "twilio" | "aircall" | "api"
  status          String   @default("uploaded")
  reportType      String   @default("medium")
  errorMessage    String?

  durationSeconds Int?     // audio duration populated after transcription

  language        String?

  transcript      String?

  summary         String?
  product         String?
  saleStatus      String?
  customerIntent  String?
  nextStep        String?
  score           Int?

  issues          Json?
  positives       Json?
  recommendations Json?

  objections      Json?
  managerMistakes Json?
  detailedReport  Json?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
